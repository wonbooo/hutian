{
  "name": "hutian",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.28.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @hutian/web --filter @hutian/desktop dev",
    "dev:web": "pnpm --filter @hutian/web dev",
    "dev:desktop": "pnpm --filter @hutian/desktop dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @hutian/web build",
    "dist:desktop": "pnpm --filter @hutian/desktop dist",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check . && pnpm -r lint",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @hutian/web db:generate",
    "db:migrate": "pnpm --filter @hutian/web db:migrate",
    "db:studio": "pnpm --filter @hutian/web db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2"
  }
}
