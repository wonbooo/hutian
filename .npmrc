# 扁平展开 node_modules。pnpm 默认的符号链接布局在 WebStorm 2026.2
# 上无法被索引（WEB-78214），依赖会全部报 module not found。
# 代价是未声明的依赖也能被导入，所以每个 import 都必须能在
# package.json 里找到对应声明，不能依赖这种泄漏。
node-linker=hoisted

# Electron 的二进制不在 npm registry 里，默认从 GitHub Releases 下载。
# 这条网络到 GitHub 不通，换国内镜像；网络正常的机器可以删掉这一行。
electron_mirror=https://npmmirror.com/mirrors/electron/
